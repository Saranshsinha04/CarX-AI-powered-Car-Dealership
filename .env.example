# Application Database (Single source of truth: PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardealership?schema=public"

# Auth / JWT Secret
NEXTAUTH_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-length"
NEXTAUTH_URL="http://localhost:3000"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_DEALERSHIP_SLUG="northstar-motors"

# AI Configuration (OpenAI API compatible)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Dealership Demo Defaults
DEFAULT_DEALERSHIP_NAME="Northstar Motors"
DEFAULT_CITY="Dehradun"
DEFAULT_STATE="Uttarakhand"
